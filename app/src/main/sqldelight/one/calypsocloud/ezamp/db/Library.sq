-- ezamp local index. Jellyfin is a sync source; every screen reads this DB, never the network.
-- Table names are prefixed so SQLDelight's generated row types (LibraryAlbum/LibraryTrack)
-- cannot collide with the domain models of the same name.

CREATE TABLE libraryAlbum (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    sortName TEXT NOT NULL DEFAULT '',
    artist TEXT NOT NULL DEFAULT '',
    year INTEGER,
    trackCount INTEGER NOT NULL DEFAULT 0,
    imageTag TEXT,
    created TEXT
);

CREATE TABLE libraryTrack (
    id TEXT NOT NULL PRIMARY KEY,
    albumId TEXT,
    albumName TEXT NOT NULL DEFAULT '',
    title TEXT NOT NULL,
    sortName TEXT NOT NULL DEFAULT '',
    artist TEXT NOT NULL DEFAULT '',
    trackNo INTEGER,
    discNo INTEGER,
    durationMs INTEGER NOT NULL DEFAULT 0,
    container TEXT,
    imageTag TEXT,
    favourite INTEGER NOT NULL DEFAULT 0,
    haystack TEXT NOT NULL DEFAULT ''
);

CREATE INDEX libraryTrack_album ON libraryTrack(albumId);
CREATE INDEX libraryTrack_sort ON libraryTrack(sortName);
CREATE INDEX libraryAlbum_sort ON libraryAlbum(sortName);
CREATE INDEX libraryAlbum_created ON libraryAlbum(created);

upsertAlbum:
INSERT OR REPLACE INTO libraryAlbum(id, name, sortName, artist, year, trackCount, imageTag, created)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

upsertTrack:
INSERT OR REPLACE INTO libraryTrack(id, albumId, albumName, title, sortName, artist, trackNo, discNo, durationMs, container, imageTag, favourite, haystack)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

clearTracks:
DELETE FROM libraryTrack;

clearAlbums:
DELETE FROM libraryAlbum;

allAlbums:
SELECT * FROM libraryAlbum ORDER BY sortName;

recentAlbums:
SELECT * FROM libraryAlbum ORDER BY created DESC LIMIT 12;

albumCount:
SELECT COUNT(*) FROM libraryAlbum;

trackCount:
SELECT COUNT(*) FROM libraryTrack;

tracksForAlbum:
SELECT * FROM libraryTrack WHERE albumId = ? ORDER BY discNo, trackNo;

setFavourite:
UPDATE libraryTrack SET favourite = ? WHERE id = ?;

favouriteTracks:
SELECT * FROM libraryTrack WHERE favourite = 1 ORDER BY title LIMIT 500;

-- Search runs against a pre-lowercased haystack, so no per-row LOWER() at query time.
searchTracks:
SELECT * FROM libraryTrack WHERE haystack LIKE :needle LIMIT 300;

-- The Tracks page: every track A-Z, walking the sortName index.
allTracks:
SELECT * FROM libraryTrack ORDER BY sortName, title COLLATE NOCASE;

-- Every name credited on a track (Jellyfin's Artists list) plus its album artist, one row each.
-- Album artist alone hid every feature and split: 54 of the 127 artists the server knows.
CREATE TABLE libraryTrackArtist (
    trackId TEXT NOT NULL,
    artist TEXT NOT NULL,
    PRIMARY KEY (trackId, artist)
);

CREATE INDEX libraryTrackArtist_artist ON libraryTrackArtist(artist);

-- Every genre Jellyfin lists on a track, one row each (migration 7).
CREATE TABLE libraryTrackGenre (
    trackId TEXT NOT NULL,
    genre TEXT NOT NULL,
    PRIMARY KEY (trackId, genre)
);

CREATE INDEX libraryTrackGenre_genre ON libraryTrackGenre(genre COLLATE NOCASE);

upsertTrackGenre:
INSERT OR IGNORE INTO libraryTrackGenre(trackId, genre) VALUES (?, ?);

clearTrackGenres:
DELETE FROM libraryTrackGenre;

trackGenreCount:
SELECT COUNT(*) FROM libraryTrackGenre;

genres:
SELECT g.genre AS genre, COUNT(*) AS trackCount
FROM libraryTrackGenre g
GROUP BY g.genre COLLATE NOCASE ORDER BY g.genre COLLATE NOCASE;

tracksByGenre:
SELECT t.* FROM libraryTrack t
JOIN libraryTrackGenre g ON g.trackId = t.id
WHERE g.genre = ? COLLATE NOCASE
ORDER BY t.sortName, t.title COLLATE NOCASE;

upsertTrackArtist:
INSERT OR IGNORE INTO libraryTrackArtist(trackId, artist) VALUES (?, ?);

clearTrackArtists:
DELETE FROM libraryTrackArtist;

trackArtistCount:
SELECT COUNT(*) FROM libraryTrackArtist;

-- An artist's albums are the albums holding at least one track that credits them.
artists:
SELECT ta.artist AS artist, COUNT(DISTINCT t.albumId) AS albumCount
FROM libraryTrackArtist ta
JOIN libraryTrack t ON t.id = ta.trackId
WHERE t.albumId IS NOT NULL
GROUP BY ta.artist ORDER BY ta.artist COLLATE NOCASE;

albumsByArtist:
SELECT a.* FROM libraryAlbum a
WHERE EXISTS (
    SELECT 1 FROM libraryTrackArtist ta
    JOIN libraryTrack t ON t.id = ta.trackId
    WHERE ta.artist = ? AND t.albumId = a.id
)
ORDER BY a.sortName;

CREATE TABLE libraryPlaylist (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    sortName TEXT NOT NULL DEFAULT '',
    trackCount INTEGER NOT NULL DEFAULT 0,
    imageTag TEXT,
    created TEXT,
    remoteCount INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE libraryPlaylistTrack (
    playlistId TEXT NOT NULL,
    trackId TEXT NOT NULL,
    position INTEGER NOT NULL,
    PRIMARY KEY (playlistId, trackId)
);

CREATE INDEX libraryPlaylistTrack_playlist ON libraryPlaylistTrack(playlistId, position);

upsertPlaylist:
INSERT OR REPLACE INTO libraryPlaylist(id, name, sortName, trackCount, imageTag, created, remoteCount)
VALUES (?, ?, ?, ?, ?, ?, ?);

upsertPlaylistTrack:
INSERT OR REPLACE INTO libraryPlaylistTrack(playlistId, trackId, position)
VALUES (?, ?, ?);

clearPlaylists:
DELETE FROM libraryPlaylist;

clearPlaylistTracks:
DELETE FROM libraryPlaylistTrack;

allPlaylistMeta:
SELECT id, trackCount, remoteCount FROM libraryPlaylist;

deletePlaylist:
DELETE FROM libraryPlaylist WHERE id = ?;

deletePlaylistTracks:
DELETE FROM libraryPlaylistTrack WHERE playlistId = ?;

allPlaylists:
SELECT * FROM libraryPlaylist WHERE trackCount > 0 ORDER BY sortName;

playlistTracks:
SELECT t.* FROM libraryTrack t
JOIN libraryPlaylistTrack p ON p.trackId = t.id
WHERE p.playlistId = ?
ORDER BY p.position;

-- Offline copies. state: 0 queued, 1 downloading, 2 done, 3 failed.
CREATE TABLE libraryDownload (
    trackId TEXT NOT NULL PRIMARY KEY,
    albumId TEXT,
    state INTEGER NOT NULL DEFAULT 0,
    bytes INTEGER NOT NULL DEFAULT 0,
    totalBytes INTEGER NOT NULL DEFAULT 0,
    path TEXT,
    error TEXT,
    updatedAt TEXT,
    mime TEXT
);

CREATE INDEX libraryDownload_album ON libraryDownload(albumId, state);

upsertDownload:
INSERT OR REPLACE INTO libraryDownload(trackId, albumId, state, bytes, totalBytes, path, error, updatedAt, mime)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

allDownloads:
SELECT * FROM libraryDownload;

downloadFor:
SELECT * FROM libraryDownload WHERE trackId = ?;

downloadsForAlbum:
SELECT * FROM libraryDownload WHERE albumId = ?;

downloadBytesForAlbum:
SELECT COALESCE(SUM(bytes), 0) FROM libraryDownload WHERE albumId = ? AND state = 2;

downloadCounts:
SELECT state, COUNT(*) AS n FROM libraryDownload GROUP BY state;

downloadBytesTotal:
SELECT COALESCE(SUM(bytes), 0) FROM libraryDownload WHERE state = 2;

-- One row per album that has at least one finished track, biggest first. Powers the storage list,
-- and the cap's "what is actually on disk" answer. Query only: no schema change, no migration.
downloadsByAlbum:
SELECT d.albumId AS albumId,
       COALESCE(a.name, d.albumId) AS name,
       COALESCE(SUM(CASE WHEN d.state = 2 THEN d.bytes ELSE 0 END), 0) AS bytes,
       SUM(CASE WHEN d.state = 2 THEN 1 ELSE 0 END) AS tracks
FROM libraryDownload d
LEFT JOIN libraryAlbum a ON a.id = d.albumId
GROUP BY d.albumId
HAVING SUM(CASE WHEN d.state = 2 THEN 1 ELSE 0 END) > 0
ORDER BY bytes DESC;

-- Downloaded-only scope lives here, not in Kotlin: one flag flips every screen at once, and the
-- index never leaves SQLite. Albums with nothing finished are invisible; no screen can name a
-- track that cannot play. Query only: no schema change, no migration.
scopedAlbums:
SELECT a.* FROM libraryAlbum a
WHERE EXISTS (
    SELECT 1 FROM libraryDownload d
    WHERE d.albumId = a.id AND d.state = 2
)
ORDER BY a.sortName;

scopedRecent:
SELECT a.* FROM libraryAlbum a
WHERE EXISTS (
    SELECT 1 FROM libraryDownload d
    WHERE d.albumId = a.id AND d.state = 2
)
ORDER BY a.created DESC LIMIT 12;

scopedTracksForAlbum:
SELECT t.* FROM libraryTrack t
JOIN libraryDownload d ON d.trackId = t.id AND d.state = 2
WHERE t.albumId = ?
ORDER BY t.discNo, t.trackNo;

scopedFavouriteTracks:
SELECT t.* FROM libraryTrack t
JOIN libraryDownload d ON d.trackId = t.id AND d.state = 2
WHERE t.favourite = 1
ORDER BY t.title LIMIT 500;

scopedSearchTracks:
SELECT t.* FROM libraryTrack t
JOIN libraryDownload d ON d.trackId = t.id AND d.state = 2
WHERE t.haystack LIKE :needle LIMIT 300;

scopedAllTracks:
SELECT t.* FROM libraryTrack t
JOIN libraryDownload d ON d.trackId = t.id AND d.state = 2
ORDER BY t.sortName, t.title COLLATE NOCASE;

scopedGenres:
SELECT g.genre AS genre, COUNT(*) AS trackCount
FROM libraryTrackGenre g
JOIN libraryDownload d ON d.trackId = g.trackId AND d.state = 2
GROUP BY g.genre COLLATE NOCASE ORDER BY g.genre COLLATE NOCASE;

scopedTracksByGenre:
SELECT t.* FROM libraryTrack t
JOIN libraryTrackGenre g ON g.trackId = t.id
JOIN libraryDownload d ON d.trackId = t.id AND d.state = 2
WHERE g.genre = ? COLLATE NOCASE
ORDER BY t.sortName, t.title COLLATE NOCASE;

scopedTrackCount:
SELECT COUNT(*) FROM libraryDownload WHERE state = 2;

scopedPlaylists:
SELECT * FROM libraryPlaylist WHERE trackCount > 0 ORDER BY sortName;

scopedPlaylistTracks:
SELECT t.* FROM libraryTrack t
JOIN libraryDownload d ON d.trackId = t.id AND d.state = 2
JOIN libraryPlaylistTrack p ON p.trackId = t.id
WHERE p.playlistId = ?
ORDER BY p.position;

-- In scope an artist counts only through tracks that actually finished downloading.
scopedArtists:
SELECT ta.artist AS artist, COUNT(DISTINCT t.albumId) AS albumCount
FROM libraryTrackArtist ta
JOIN libraryTrack t ON t.id = ta.trackId
JOIN libraryDownload d ON d.trackId = t.id AND d.state = 2
WHERE t.albumId IS NOT NULL
GROUP BY ta.artist ORDER BY ta.artist COLLATE NOCASE;

scopedAlbumsByArtist:
SELECT a.* FROM libraryAlbum a
WHERE EXISTS (
    SELECT 1 FROM libraryTrackArtist ta
    JOIN libraryTrack t ON t.id = ta.trackId
    JOIN libraryDownload d ON d.trackId = t.id AND d.state = 2
    WHERE ta.artist = ? AND t.albumId = a.id
)
ORDER BY a.sortName;

-- done/total per album for the partial badge: (finished, indexed).
-- CAST keeps the column a plain INTEGER so the generated getter is Long, not Number.
doneCountForAlbum:
SELECT CAST(SUM(CASE WHEN d.state = 2 THEN 1 ELSE 0 END) AS INTEGER) FROM libraryDownload d WHERE d.albumId = ?;

allDownloadedIds:
SELECT trackId FROM libraryDownload WHERE state = 2;

deleteDownload:
DELETE FROM libraryDownload WHERE trackId = ?;

deleteDownloadsForAlbum:
DELETE FROM libraryDownload WHERE albumId = ?;

deleteAllDownloads:
DELETE FROM libraryDownload;

-- Local playlists (migration 8): made on this phone, never sent to Jellyfin. A sync never touches
-- these tables. owner = "<server>|<user>"; most recently changed first, so the list you just used
-- leads the add-to-playlist sheet.
CREATE TABLE localPlaylist (
    id TEXT NOT NULL PRIMARY KEY,
    owner TEXT NOT NULL,
    name TEXT NOT NULL,
    updated INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE localPlaylistTrack (
    playlistId TEXT NOT NULL,
    trackId TEXT NOT NULL,
    position INTEGER NOT NULL,
    PRIMARY KEY (playlistId, trackId)
);

CREATE INDEX localPlaylistTrack_playlist ON localPlaylistTrack(playlistId, position);

localPlaylists:
SELECT p.id, p.name,
    (SELECT COUNT(*) FROM localPlaylistTrack lt JOIN libraryTrack t ON t.id = lt.trackId
        WHERE lt.playlistId = p.id) AS trackCount,
    (SELECT t.albumId FROM localPlaylistTrack lt JOIN libraryTrack t ON t.id = lt.trackId
        WHERE lt.playlistId = p.id ORDER BY lt.position LIMIT 1) AS coverId,
    (SELECT t.imageTag FROM localPlaylistTrack lt JOIN libraryTrack t ON t.id = lt.trackId
        WHERE lt.playlistId = p.id ORDER BY lt.position LIMIT 1) AS coverTag
FROM localPlaylist p
WHERE p.owner = ?
ORDER BY p.updated DESC;

createLocalPlaylist:
INSERT INTO localPlaylist(id, owner, name, updated) VALUES (?, ?, ?, ?);

renameLocalPlaylist:
UPDATE localPlaylist SET name = ?, updated = ? WHERE id = ?;

touchLocalPlaylist:
UPDATE localPlaylist SET updated = ? WHERE id = ?;

deleteLocalPlaylist:
DELETE FROM localPlaylist WHERE id = ?;

deleteLocalPlaylistTracks:
DELETE FROM localPlaylistTrack WHERE playlistId = ?;

addLocalPlaylistTrack:
INSERT OR IGNORE INTO localPlaylistTrack(playlistId, trackId, position)
VALUES (:playlistId, :trackId,
    (SELECT COALESCE(MAX(position), -1) + 1 FROM localPlaylistTrack WHERE playlistId = :playlistId));

removeLocalPlaylistTrack:
DELETE FROM localPlaylistTrack WHERE playlistId = ? AND trackId = ?;

localPlaylistsWithTrack:
SELECT lt.playlistId FROM localPlaylistTrack lt
JOIN localPlaylist p ON p.id = lt.playlistId
WHERE lt.trackId = ? AND p.owner = ?;

localPlaylistTracks:
SELECT t.* FROM libraryTrack t
JOIN localPlaylistTrack p ON p.trackId = t.id
WHERE p.playlistId = ?
ORDER BY p.position;

scopedLocalPlaylistTracks:
SELECT t.* FROM libraryTrack t
JOIN libraryDownload d ON d.trackId = t.id AND d.state = 2
JOIN localPlaylistTrack p ON p.trackId = t.id
WHERE p.playlistId = ?
ORDER BY p.position;
